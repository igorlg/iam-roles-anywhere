# Certificates From Somewhere Other Than `iam-ra`
#
# `source = "files"` takes any path, so the module works with certificates
# managed outside `iam-ra` - a corporate PKI, cert-manager, or your own CA.
# This example shows SOPS and agenix.
#
# READ THIS FIRST
#
# If the key was generated by `iam-ra host request` or `iam-ra host
# enroll`, you do NOT want this file. The key is already on the host, and
# encrypting a second copy of it into your repo gains nothing while
# reintroducing exactly what v3 removed: a private key that exists
# somewhere other than the host that uses it. See ./minimal.nix.
#
# This pattern is right when something else owns the key's lifecycle and
# the host is a consumer. It is wrong as a way to distribute
# `iam-ra`-generated keys.
#
# Note that only the KEY needs a secrets manager. The certificate is
# public - it is presented in TLS handshakes - so it can be a plain
# committed path. The examples below encrypt both only because the two
# usually arrive together.
#
{ config, ... }:
{
  # ==========================================================
  # Option A: SOPS (sops-nix)
  # ==========================================================
  #
  # Note that sops-nix's /run/secrets is Linux-only. On Darwin the paths
  # differ, which is one reason the macosKeychain backend exists - see
  # ./keychain.nix.
  sops.secrets."iam-ra/cert" = {
    sopsFile = ./secrets/iam-ra-default.yaml;
    key = "certificate";
  };
  sops.secrets."iam-ra/key" = {
    sopsFile = ./secrets/iam-ra-default.yaml;
    key = "private_key";
  };

  programs.iamRolesAnywhere = {
    enable = true;
    user = "alice";

    identities.default = {
      certificate = {
        source = "files";
        certPath = config.sops.secrets."iam-ra/cert".path;
        keyPath = config.sops.secrets."iam-ra/key".path;
      };

      trustAnchorArn = "arn:aws:rolesanywhere:ap-southeast-2:123456789012:trust-anchor/abc123";
      region = "ap-southeast-2";

      profiles.admin = {
        profileArn = "arn:aws:rolesanywhere:ap-southeast-2:123456789012:profile/admin-profile";
        roleArn = "arn:aws:iam::123456789012:role/iam-ra-admin";
        makeDefault = true;
      };
    };
  };

  # ==========================================================
  # Option B: agenix
  # ==========================================================
  #
  #   age.secrets.iam-ra-cert.file = ./secrets/iam-ra-cert.age;
  #   age.secrets.iam-ra-key.file = ./secrets/iam-ra-key.age;
  #
  #   programs.iamRolesAnywhere.identities.default.certificate = {
  #     source = "files";
  #     certPath = config.age.secrets.iam-ra-cert.path;
  #     keyPath = config.age.secrets.iam-ra-key.path;
  #   };

  # ==========================================================
  # Option C: plain static files
  # ==========================================================
  #
  #   programs.iamRolesAnywhere.identities.default.certificate = {
  #     source = "files";
  #     certPath = "/etc/ssl/iam-ra/cert.pem";
  #     keyPath = "/etc/ssl/iam-ra/key.pem";
  #   };
}

# Constraint worth knowing: keyPath must be a real, re-readable file.
# The credential helper re-opens the key on every operation, so a FIFO,
# process substitution, or /dev/stdin fails after the first read.
